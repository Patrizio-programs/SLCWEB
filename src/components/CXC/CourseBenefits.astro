---
/* CourseBenefits.astro */
import "bootstrap-icons/font/bootstrap-icons.css";
---

<section class="container my-3">
  <div class="card shadow-sm p-4">
    <h2 class="text-center mb-4">Course Benefits</h2>
    <ul class="list-unstyled">
      <li class="d-flex align-items-center mb-3">
        <span class="text-warning me-2">
          <i class="bi bi-check-circle-fill" style="color: #8F602C;"></i>
        </span>
        Step-by-step grammar explanations
      </li>
      <li class="d-flex align-items-center mb-3">
        <span class="text-warning me-2">
          <i class="bi bi-check-circle-fill" style="color: #8F602C;"></i>
        </span>
        Practice with past CXC papers
      </li>
      <li class="d-flex align-items-center mb-3">
        <span class="text-warning me-2">
          <i class="bi bi-check-circle-fill" style="color: #8F602C;"></i>
        </span>
        Accessible resources for all levels
      </li>
      <li class="d-flex align-items-center mb-3">
        <span class="text-warning me-2">
          <i class="bi bi-check-circle-fill" style="color: #8F602C;"></i>
        </span>
        Interact with native speakers
      </li>
    </ul>
  </div>
</section>
<style>
  h2 {
    font-weight: bold;
    color: var(--color-secondary);
  }
</style>
