---
// Sitewide alert bar.
// Edit the message, CTA, and variant here in one place.
// To disable the bar site-wide, set `visible` to false.
const visible = true;
const message = "Free Spanish class this month — Introduction & Fundamentals to CXC Spanish, Sat Nov 28 at 6:00 PM AST!";
const ctaLabel = "Add to Calendar";
const ctaHref = "https://calendar.app.google/TomGPVDci413t25Q9";
const icon = "bi bi-mortarboard-fill";
---

{visible && (
  <div
    class="alert-bar alert alert-dismissible fade show mb-0"
    role="alert"
  >
    <div class="alert-bar-inner">
      <i class={`alert-bar-icon ${icon}`}></i>
      <span class="alert-bar-text">{message}</span>
      <a href={ctaHref} class="alert-bar-cta">
        {ctaLabel} <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
    <button
      type="button"
      class="btn-close btn-close-white"
      data-bs-dismiss="alert"
      aria-label="Close alert"
    ></button>
  </div>
)}

<style>
  .alert-bar {
    /* Bronze accent from the brand palette, with a hex fallback
       in case the CSS variable isn't defined downstream. */
    background-color: var(--color-accent, #8f602c);
    color: #fff;
    border: none;
    border-radius: 0; /* full-width, no rounded corners */
    padding: 0.55rem 2.5rem 0.55rem 1rem;
    font-size: 0.95rem;
    font-weight: 500;
    text-align: center;
  }

  .alert-bar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .alert-bar-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .alert-bar-text {
    line-height: 1.3;
  }

  .alert-bar-cta {
    color: #fff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .alert-bar-cta:hover {
    color: #fff;
    text-decoration: none;
    opacity: 0.85;
  }

  /* Keep the close button pinned to the right edge without
     throwing off the centered text. */
  .alert-bar .btn-close {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    transform: translateY(-50%);
    padding: 0.75rem;
    opacity: 0.9;
  }

  .alert-bar .btn-close:hover {
    opacity: 1;
  }

  @media (max-width: 575.98px) {
    .alert-bar {
      padding: 0.5rem 2.5rem 0.5rem 0.75rem;
      font-size: 0.85rem;
    }
    .alert-bar-inner {
      gap: 0.35rem;
    }
  }
</style>