<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Alfabeto en Español</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <section class="py-5 bg-light">
      <div class="container">
        <div class="text-center mb-4">
          <h2 class="fw-bold">Alfabeto en Español</h2>
          <p class="text-muted">Click the button below the letter to hear the sound</p>
        </div>

        <!-- Alphabet Grid -->
        <div class="row g-3 justify-content-center">
          {['A','B','C','D','E','F','G','H','I','J','K','L','M','N','Ñ','O','P','Q','R','S','T','U','V','W','X','Y','Z'].map(letter => (
            <div class="col-3 col-md-2 text-center">
              <div class="card shadow-sm border-0">
                <div class="card-body">
                  <h4 class="fw-bold">{letter}</h4>
                  <button class="btn btn-primary btn-sm mt-2" onclick={`playAudio('${letter}')`}>
                    🔊 Escuchar
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Combinations -->
        <div class="text-center mt-5 mb-3">
          <h3 class="fw-bold">Vocales Y Combinaciones</h3>
          <p class="text-muted">Letter combinations</p>
        </div>

        <div class="row g-3 justify-content-center">
          {['BA','BANDA','BE','BESO' ,'BI','BICHO','BO','BOCA','BU','BUZO'].map(combo => (
            <div class="col-3 col-md-2 text-center">
              <div class="card shadow-sm border-0">
                <div class="card-body">
                  <h5 class="fw-bold">{combo}</h5>
                  <button class="btn btn-success btn-sm mt-2" onclick={`playAudio('${combo}')`}>
                    🔊 Escuchar
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <script>
      declare global {
        interface Window {
          playAudio: (text: string) => void;
        }
      }

      window.playAudio = function (text) {
        const audio = new Audio(`/audio/${text.toLowerCase()}.mp3`);
        audio.play();
      };
    </script>
  </body>
</html>
