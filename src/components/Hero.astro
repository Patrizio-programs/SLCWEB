---

---

<section>
  <!-- Hero Section -->
  <header class="hero-section text-white">
    <div class="container hero-content">
      <div class="extra div">
        <h1 class="hero-title">SLC COURSES</h1>
        <p class="hero-subtitle">Join our community of learners today!</p>
        <button id="signUpBtn" class="btn border-info btn-lg"
          >✨Enter Class✨</button
        >
      </div>
    </div>
  </header>
</section>

<style>
  .hero-section {
    background: url("../assets/mainhero.png") no-repeat center center;
    background-size: cover;
    min-height: 80vh;
  }

  #signUpBtn {
    border-radius: 30px;
    color: white;
    background-color: var(--color-primary);
    transition: all 0.3s ease;
  }
  #signUpBtn:hover {
    background-color: white;
    color: var(--color-primary);
  }

  .hero-content {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 80vh;
    max-width: 700px;
  }

  .extra.div {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1rem;
  }

  .hero-title {
    display: none;
  }

  .hero-subtitle {
    display: none;
  }

  .btn {
    top: auto;
    left: auto;
    bottom: auto;
  }

  @media (max-width: 600px) {
    .hero-section {
      background: url("../assets/hero2.png") no-repeat center center;
      background-size: cover;
      max-height: 350px;
    }

    .hero-content {
      grid-template-columns: 1fr;
    }

    .extra.div {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 1rem;
    }

    .hero-title {
      display: block;
    }

    .hero-subtitle {
      display: block;
    }
  }

  @media (min-width: 769px) {
    .hero-content {
      grid-template-columns: 1fr;
    }

    .extra.div {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 1rem;
    }

    .hero-title {
      display: none;
    }

    .hero-subtitle {
      display: none;
    }
  }
</style>
