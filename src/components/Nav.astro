---
import logo from "../assets/logo_nobg.png";
import { Image } from "astro:assets";
import { client } from "../../tina/__generated__/client";

const query = await client.queries.nav({
  relativePath: "nav.md",
});
const nav = query.data.nav;
---

<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid d-flex">
    <a class="navbar-brand me-auto" href="/">
      <Image
        src={logo}
        alt="Logo"
        width="60"
        height="60"
        class="d-inline-block align-text-middle"
      />
      SIMPLE LANGUAGE CENTRE
    </a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav mx-auto">
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href={nav.nav1Link}
            >{nav.nav1Label}</a
          >
        </li>
        <li class="nav-item">
          <a class="nav-link" href={nav.nav2Link}>{nav.nav2Label}</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href={nav.nav3Link}>{nav.nav3Label}</a>
        </li>
      </ul>
   <a
  href="https://tally.so/r/lbQyjV"
  target="_blank"
  rel="noopener noreferrer"
  class="btn btn-primary ms-auto"
  style="background-color: var(--color-primary); border-color: var(--color-primary);"
  >Register Now</a
>
    </div>
  </div>
</nav>
<hr class="my-1" />
