---
import { client }  from "../../../tina/__generated__/client"
const query = await client.queries.courses({
  relativePath: "BeginnerCourse.md",

});
//this is the data for the beginner course
const beginner = query.data.courses;
const intermediateQuery = await client.queries.courses({
  relativePath: "IntermediateCourse.md",
});
//this is the data for the intermediate course
const intermediate = intermediateQuery.data.courses;
const advancedQuery = await client.queries.courses({
  relativePath: "AdvancedCourse.md",
});
//this is the data for the advanced course
const advanced = advancedQuery.data.courses;

const CXC = await client.queries.courses({
  relativePath: "CXC.md",
});
//this is the data for the CXC prep course
const cxc = CXC.data.courses;
---

<section id="courses" class="py-5 bg-light">
  <div class="container py-4">
    <div class="text-center mb-5">
      <span class="text-uppercase fw-bold span-text tracking-wide">Our Programs</span>
      <h2 class="display-5 fw-bold text-dark mt-2">Explore Our Courses</h2>
      <p class="lead text-muted mx-auto" style="max-width: 600px;">
        Tailored language programs designed to take you from foundational basics to certified exam mastery.
      </p>
    </div>

    <div class="row g-4">
      <div class="col-12 col-md-6 col-lg-3 d-flex align-items-stretch">
        <div class="card h-100 border-0 shadow-sm rounded-4 course-card w-100">
          <div class="card-body d-flex flex-column p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="badge bg-success px-3 py-2 rounded-pill fw-normal">Beginner</span>
              <small class="text-muted fw-semibold">{beginner.lessonNumber}</small>
            </div>

            <h3 class="h4 card-title fw-bold text-dark mb-2">Basic Level</h3>
            <p class="card-text text-secondary small mb-4">
              {beginner.ClassDescription}
            </p>

            <hr class="text-muted opacity-25 mb-3" />

            <ul class="list-unstyled flex-grow-1 mb-4">
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {beginner.detail1}
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {beginner.detail2}
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {beginner.detail3}
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {beginner.detail4}
              </li>
            </ul>

            <a href={beginner.enrollFormLink} target="_blank" class="btn btn-outline-primary rounded-pill w-100 fw-bold py-2 mt-auto">
              Enroll Now
            </a>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-lg-3 d-flex align-items-stretch">
        <div class="card h-100 border-0 shadow-sm rounded-4 course-card w-100">
          <div class="card-body d-flex flex-column p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="badge bg-primary px-3 py-2 rounded-pill fw-normal">Popular</span>
              <small class="text-muted fw-semibold">{intermediate.lessonNumber}</small>
            </div>

            <h3 class="h4 card-title fw-bold text-dark mb-2">Intermediate Level</h3>
            <p class="card-text text-secondary small mb-4">
              {intermediate.ClassDescription}
            </p>

            <hr class="text-muted opacity-25 mb-3" />

            <ul class="list-unstyled flex-grow-1 mb-4">
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {intermediate.detail1}
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {intermediate.detail2}
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {intermediate.detail3}
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {intermediate.detail4}
              </li>
            </ul>

            <a href={intermediate.enrollFormLink} target="_blank" class="btn btn-outline-primary rounded-pill w-100 fw-bold py-2 mt-auto">
              Enroll Now
            </a>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-lg-3 d-flex align-items-stretch">
        <div class="card h-100 border-0 shadow-sm rounded-4 course-card w-100">
          <div class="card-body d-flex flex-column p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="badge bg-dark px-3 py-2 rounded-pill fw-normal">Mastery</span>
              <small class="text-muted fw-semibold">{advanced.lessonNumber}</small>
            </div>

            <h3 class="h4 card-title fw-bold text-dark mb-2">Advanced Level</h3>
            <p class="card-text text-secondary small mb-4">
              {advanced.ClassDescription}
            </p>

            <hr class="text-muted opacity-25 mb-3" />

            <ul class="list-unstyled flex-grow-1 mb-4">
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {advanced.detail1}
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {advanced.detail2}
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {advanced.detail3}
              </li>
             
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {advanced.detail4}
              </li>         
            </ul>
        

            <a href={advanced.enrollFormLink} target="_blank"class="btn btn-outline-primary rounded-pill w-100 fw-bold py-2 mt-auto">
              Enroll Now
            </a>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-lg-3 d-flex align-items-stretch">
        <div class="card h-100 border-0 shadow-sm rounded-4 course-card w-100">
          <div class="card-body d-flex flex-column p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-normal">Exam Prep</span>
              <small class="text-muted fw-semibold">{cxc.lessonNumber}</small>
            </div>

            <h3 class="h4 card-title fw-bold text-dark mb-2">CXC Preparation</h3>
            <p class="card-text text-secondary small mb-4">
              {cxc.ClassDescription}
            </p>

            <hr class="text-muted opacity-25 mb-3" />

            <ul class="list-unstyled flex-grow-1 mb-4">
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {cxc.detail1}
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {cxc.detail2}
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {cxc.detail3}
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> {cxc.detail4}
              </li>
            </ul>

            <a href={cxc.enrollFormLink} target="_blank" class="btn btn-outline-primary rounded-pill w-100 fw-bold py-2 mt-auto">
              Enroll Now
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tracking-wide {
    letter-spacing: 1.5px;
  }
  .course-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .course-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08) !important;
  }
  .span-text{
    color: var(--color-secondary);
  }
</style>