<section id="courses" class="py-5 bg-light">
  <div class="container py-4">
    <div class="text-center mb-5">
      <span class="text-uppercase fw-bold text-primary tracking-wide">Our Programs</span>
      <h2 class="display-5 fw-bold text-dark mt-2">Explore Our Courses</h2>
      <p class="lead text-muted mx-auto" style="max-width: 600px;">
        Tailored language programs designed to take you from foundational basics to certified exam mastery.
      </p>
    </div>

    <div class="row g-4">
      <div class="col-12 col-md-6 col-lg-3 d-flex align-items-stretch">
        <div class="card h-100 border-0 shadow-sm rounded-4 course-card w-100">
          <div class="card-body d-flex flex-column p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="badge bg-success px-3 py-2 rounded-pill fw-normal">Beginner</span>
              <small class="text-muted fw-semibold">8 Weeks</small>
            </div>

            <h3 class="h4 card-title fw-bold text-dark mb-2">Basic Level</h3>
            <p class="card-text text-secondary small mb-4">
              Build a strong foundation in grammar, essential vocabulary, and everyday conversational skills through interactive practice.
            </p>

            <hr class="text-muted opacity-25 mb-3" />

            <ul class="list-unstyled flex-grow-1 mb-4">
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> Core grammar & phrasebook vocabulary
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> Basic pronunciation & listening drills
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> Interactive conversational practice
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> Weekly exercises & feedback
              </li>
            </ul>

            <a href="#enroll" class="btn btn-outline-primary rounded-pill w-100 fw-bold py-2 mt-auto">
              Enroll Now
            </a>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-lg-3 d-flex align-items-stretch">
        <div class="card h-100 border-0 shadow-sm rounded-4 course-card w-100">
          <div class="card-body d-flex flex-column p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="badge bg-primary px-3 py-2 rounded-pill fw-normal">Popular</span>
              <small class="text-muted fw-semibold">10 Weeks</small>
            </div>

            <h3 class="h4 card-title fw-bold text-dark mb-2">Intermediate Level</h3>
            <p class="card-text text-secondary small mb-4">
              Expand your vocabulary, master complex sentence structures, and improve fluency for professional and social interactions.
            </p>

            <hr class="text-muted opacity-25 mb-3" />

            <ul class="list-unstyled flex-grow-1 mb-4">
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> Advanced grammar & idioms
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> Fluency & accent refinement
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> Reading comprehension & writing
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> Group discussions & debate
              </li>
            </ul>

            <a href="#enroll" class="btn btn-outline-primary rounded-pill w-100 fw-bold py-2 mt-auto">
              Enroll Now
            </a>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-lg-3 d-flex align-items-stretch">
        <div class="card h-100 border-0 shadow-sm rounded-4 course-card w-100">
          <div class="card-body d-flex flex-column p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="badge bg-dark px-3 py-2 rounded-pill fw-normal">Mastery</span>
              <small class="text-muted fw-semibold">12 Weeks</small>
            </div>

            <h3 class="h4 card-title fw-bold text-dark mb-2">Advanced Level</h3>
            <p class="card-text text-secondary small mb-4">
              Achieve native-like fluency, master nuanced expression, and refine writing for academic or executive business contexts.
            </p>

            <hr class="text-muted opacity-25 mb-3" />

            <ul class="list-unstyled flex-grow-1 mb-4">
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> Executive & academic writing
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> Nuanced expression & idiom mastery
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> Real-world media analysis
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> 1-on-1 personalized sessions
              </li>
            </ul>

            <a href="#enroll" class="btn btn-outline-primary rounded-pill w-100 fw-bold py-2 mt-auto">
              Enroll Now
            </a>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 col-lg-3 d-flex align-items-stretch">
        <div class="card h-100 border-0 shadow-sm rounded-4 course-card w-100">
          <div class="card-body d-flex flex-column p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-normal">Exam Prep</span>
              <small class="text-muted fw-semibold">14 Weeks</small>
            </div>

            <h3 class="h4 card-title fw-bold text-dark mb-2">CXC Preparation</h3>
            <p class="card-text text-secondary small mb-4">
              Targeted preparation for the CXC / CSEC language examination covering paper components, oral exams, and past papers.
            </p>

            <hr class="text-muted opacity-25 mb-3" />

            <ul class="list-unstyled flex-grow-1 mb-4">
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> CSEC syllabus-aligned topics
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> Past paper walkthroughs & mock tests
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> Oral exam practice & feedback
              </li>
              <li class="d-flex align-items-center mb-2 small text-secondary">
                <span class="text-primary me-2">✓</span> SBA guidance & scoring strategies
              </li>
            </ul>

            <a href="#enroll" class="btn btn-outline-primary rounded-pill w-100 fw-bold py-2 mt-auto">
              Enroll Now
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tracking-wide {
    letter-spacing: 1.5px;
  }
  .course-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .course-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08) !important;
  }
</style>