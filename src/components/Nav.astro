---
import logo from "../assets/logo.png";
---

<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid d-flex">
    <a class="navbar-brand me-auto" href="#">
      <img src={logo.src} alt="Logo" width="60" height="60" class="d-inline-block align-text-middle" />
      SIMPLE LANGUAGE CENTRE
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav mx-auto">
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="#">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#">Features</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#">Pricing</a>
        </li>
      </ul>
      <button type="button" class="btn btn-primary ms-auto" style="background-color: var(--color-primary); border-color: var(--color-primary);">Register Now</button>
    </div>
  </div>
</nav>
<hr class="my-1" />