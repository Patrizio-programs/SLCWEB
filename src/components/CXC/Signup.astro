---
import { client } from "../../../tina/__generated__/client";

const query = await client.queries.hero({
  relativePath: "Prepare-for-Success-in-CXC-Spanish.md",
});
const hero = query.data.hero;
---

<section class="hero-section">
  <div class="container text-center">
    <h1 class="hero-title">
      {hero.heroTitle}
    </h1>
    <p class="hero-text">
      {
        "Master the Spanish Language and Ace your exams with our comprehensive and engaging courses."
      }
    </p>
    <button class="btn btn-lg hero-button">{"Sign Up Now"}</button>
  </div>
</section>

<style>
  .hero-section {
    padding: 100px 0;
    background: linear-gradient(135deg, #16703d, #1d8a4a, #0f4d2a);
    color: white;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: bold;
    margin-bottom: 1.5rem;
  }

  .hero-text {
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .hero-button {
    padding: 15px 40px;
    font-size: 1.2rem;
    border-radius: 30px;
    background-color: #fff;
    color: var(--color-primary);
    border: none;
    transition: all 0.3s ease;
  }

  .hero-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px var(--color-primary-light);
  }
  .hero-button:active {
    background-color: var(--color-secondary);
    transform: translateY(0);
    box-shadow: none;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }
    .hero-text {
      font-size: 1rem;
    }
  }
</style>
